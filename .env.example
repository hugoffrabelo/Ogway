# URL da API Django (config/settings.py CORS_ALLOWED_ORIGINS precisa
# incluir a origem deste front — ver DJANGO_CORS_ALLOWED_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Formulário de contato da landing (components/contact.tsx).
# Endpoint que aceita POST JSON (ex.: https://formspree.io/f/xxxxxx). Opcional.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# E-mail do encarregado: aparece no aviso de privacidade, ao lado do
# formulário e é o fallback (mailto:) quando não há endpoint.
NEXT_PUBLIC_CONTACT_EMAIL=
# URL pública do site, sem barra no fim (canonical, sitemap, schema.org).
# Vazia = https://hugoffrabelo.github.io/Ogway
NEXT_PUBLIC_SITE_URL=
